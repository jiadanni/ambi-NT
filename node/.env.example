# Example Environment Configuration for Secure Node Deployment

# ============================================================================
# BASIC CONFIGURATION
# ============================================================================

# Unique identifier for this node
NODE_ID=node-secure-001

# Port the node listens on
NODE_PORT=8000

# ============================================================================
# OLLAMA CONFIGURATION
# ============================================================================

# Ollama API endpoint
OLLAMA_HOST=http://localhost:11434

# Model to use for inference
OLLAMA_MODEL=llama3:8b

# ============================================================================
# PERFORMANCE SETTINGS
# ============================================================================

# Maximum number of jobs to process concurrently
MAX_CONCURRENT_JOBS=2

# Maximum time (seconds) to wait for Ollama response
JOB_TIMEOUT_SECONDS=120

# ============================================================================
# SECURITY SETTINGS (CRITICAL)
# ============================================================================

# === Rate Limiting ===
# ALWAYS ENABLE IN PRODUCTION
ENABLE_RATE_LIMITING=true

# Maximum requests per minute per client public key
# Lower = more restrictive, Higher = more permissive
# Recommended: 5-20 for production
RATE_LIMIT_PER_CLIENT=10

# Maximum requests per minute globally (all clients)
# Should be higher than per-client limit
# Prevents distributed DoS with many client keys
# Recommended: 50-200 for production
RATE_LIMIT_GLOBAL=100

# === Prompt Sanitization ===
# ALWAYS ENABLE IN PRODUCTION
# Detects and blocks prompt injection attacks
ENABLE_PROMPT_SANITIZATION=true

# Maximum prompt length in characters
# Larger prompts use more compute and memory
# Recommended: 5000-10000 for production
MAX_PROMPT_LENGTH=10000

# === Proof-of-Work (Optional) ===
# Requires clients to solve computational puzzle before submitting jobs
# Adds latency but prevents spam
# Recommended: false for trusted clients, true for public nodes
ENABLE_PROOF_OF_WORK=false

# Difficulty of proof-of-work (number of leading zeros required)
# Higher = more CPU required from client
# Recommended: 4-6 if enabled
POW_DIFFICULTY=4

# === Client Authentication (Optional) ===
# Comma-separated list of allowed client public keys (base64)
# If set, only these clients can submit jobs
# Leave empty to allow any client (with rate limiting)
# Recommended: Set for private deployments, empty for public
ALLOWED_CLIENT_KEYS=

# Example allowlist (uncomment and add your client keys):
# ALLOWED_CLIENT_KEYS=Abc123ClientKey1Base64==,Def456ClientKey2Base64==

# === Client Signature Verification (Future) ===
# Require clients to sign requests with their private key
# Not yet implemented - planned for Phase 4
REQUIRE_CLIENT_SIGNATURE=false

# ============================================================================
# CRYPTOGRAPHY
# ============================================================================

# Node's private key (base64-encoded)
# CRITICAL: Keep this secret! Do not commit to git!
# Generate with: python -c "from node.crypto import generate_keypair; sk, pk = generate_keypair(); print(f'NODE_PRIVATE_KEY={sk}')"
NODE_PRIVATE_KEY=

# Node's public key (base64-encoded)
# This can be shared publicly - clients use it to encrypt prompts
NODE_PUBLIC_KEY=

# ============================================================================
# COORDINATOR (Phase 2+)
# ============================================================================

# URL of the coordinator service (if using federation)
# Leave empty for standalone mode
COORDINATOR_URL=

# Example: COORDINATOR_URL=http://coordinator.example.com:8080

# How often to send heartbeat to coordinator (seconds)
HEARTBEAT_INTERVAL_SECONDS=60

# ============================================================================
# NETWORK (Advanced)
# ============================================================================

# Public IP address (auto-detected if not set)
# Only needed if auto-detection fails or for manual override
PUBLIC_IP=

# ============================================================================
# DEBUGGING
# ============================================================================

# Enable debug logging (verbose output)
# Recommended: false in production
ENABLE_DEBUG_LOGS=false

# ============================================================================
# DEPLOYMENT PROFILES
# ============================================================================

# === Profile: Development (Local Testing) ===
# ENABLE_RATE_LIMITING=false
# ENABLE_PROMPT_SANITIZATION=true
# RATE_LIMIT_PER_CLIENT=100
# RATE_LIMIT_GLOBAL=1000
# MAX_PROMPT_LENGTH=50000
# ENABLE_DEBUG_LOGS=true

# === Profile: Production Private (Trusted Clients) ===
# ENABLE_RATE_LIMITING=true
# ENABLE_PROMPT_SANITIZATION=true
# RATE_LIMIT_PER_CLIENT=20
# RATE_LIMIT_GLOBAL=200
# MAX_PROMPT_LENGTH=10000
# ALLOWED_CLIENT_KEYS=<your-trusted-keys>
# ENABLE_PROOF_OF_WORK=false

# === Profile: Production Public (Internet-Facing) ===
# ENABLE_RATE_LIMITING=true
# ENABLE_PROMPT_SANITIZATION=true
# RATE_LIMIT_PER_CLIENT=5
# RATE_LIMIT_GLOBAL=50
# MAX_PROMPT_LENGTH=5000
# ENABLE_PROOF_OF_WORK=true
# POW_DIFFICULTY=5
# MAX_CONCURRENT_JOBS=1
# JOB_TIMEOUT_SECONDS=60
