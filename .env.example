# Ambient Intelligence - Environment Configuration Template
# Copy this file to .env and customize for your setup
# NEVER commit the .env file to version control!

# ============================================
# Node Configuration
# ============================================
NODE_ID=                          # Auto-generated UUID on first run
NODE_PORT=8000                    # Port for node API
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b            # Default model to use
MAX_CONCURRENT_JOBS=1             # Phase 0: Single-threaded
JOB_TIMEOUT_SECONDS=120           # Kill jobs after this timeout
ENABLE_DEBUG_LOGS=false           # Never enable in production

# ============================================
# Encryption (Auto-generated on first run)
# ============================================
NODE_PRIVATE_KEY=                 # Auto-generated on first run (NaCl key)
NODE_PUBLIC_KEY=                  # Derived from private key

# ============================================
# Phase 2+ Only - Coordinator Integration
# ============================================
COORDINATOR_URL=                  # URL of bootstrap coordinator
HEARTBEAT_INTERVAL_SECONDS=60     # How often to announce to coordinator
PRIORITY_TOKEN_MULTIPLIER=2.0     # Earn 2 tokens per compute minute

# ============================================
# Coordinator Configuration (Phase 2+)
# ============================================
DATABASE_URL=postgresql://user:pass@localhost/ambient
POSTGRES_DB=ambient
POSTGRES_USER=ambient
POSTGRES_PASSWORD=ambient
REDIS_URL=redis://localhost:6379/0
COORDINATOR_PORT=5000
JWT_SECRET_KEY=                   # For signing priority tokens
ADMIN_TOKEN=                      # For admin endpoints
PUBLIC_IP=                        # Override auto-detection (optional)

# ============================================
# Client Configuration
# ============================================
DEFAULT_NODE_URL=http://localhost:8000  # Default node for CLI client
WHISPER_MODEL=base.en             # For voice transcription
ENABLE_HISTORY=false              # Privacy-first default
HISTORY_ENCRYPTION_ENABLED=true   # If history enabled, always encrypt

# ============================================
# Federation (Phase 3+)
# ============================================
PEER_COORDINATORS=                # Comma-separated URLs of peer coordinators
